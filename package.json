{
    "name": "Dutch25-extension",
    "version": "1.1.3",
    "repositoryName": "Dutch25",
    "baseURL": "https://dutch25.github.io/VietSource/",
    "description": "Paperback extension of Dutch25",
    "scripts": {
        "bundle": "npx paperback bundle",
        "serve": "npx paperback serve",
        "dev": "npx nodemon --watch \"**/*.ts\" --ext \"js ts\" --exec \"npm run serve\""
    },
    "dependencies": {
        "@paperback/toolchain": "0.8.0-alpha.47",
        "@paperback/types": "0.8.0-alpha.47",
        "crypto-js": "^4.2.0",
        "node-fetch": "^3.3.2",
        "puppeteer": "^25.4.0"
    },
    "devDependencies": {
        "@types/crypto-js": "^4.2.2",
        "cheerio": "^1.2.0",
        "ts-node": "^10.9.2",
        "typescript": "^4.3.2"
    }
}
